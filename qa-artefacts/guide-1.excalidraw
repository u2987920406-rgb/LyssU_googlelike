{ "type": "excalidraw", "version": 2, "source": "hermes-agent", "elements": [ { "type": "text", "id": "p1-t", "x": 140, "y": 20, "text": "5 rôles du cabinet", "fontSize": 32, "fontFamily": 1, "strokeColor": "#1e1e1e", "originalText": "5 rôles du cabinet", "autoResize": true }, { "type": "text", "id": "p1-s1", "x": 140, "y": 55, "text": "La machine de dialogue Hermès", "fontSize": 18, "fontFamily": 1, "strokeColor": "#757575", "originalText": "La machine de dialogue Hermès", "autoResize": true }, { "type": "rectangle", "id": "p1-box-1", "x": 40, "y": 90, "width": 170, "height": 120, "roundness": { "type": 3 }, "backgroundColor": "#a5d8ff", "fillStyle": "solid", "boundElements": [ { "id": "p1-t-1", "type": "text" } ] }, { "type": "text", "id": "p1-t-1", "x": 45, "y": 110, "width": 160, "height": 80, "text": "Conception\n\nLe concepteur\ncoupe les décisions\nen plans clairs\navant de coder.", "fontSize": 16, "fontFamily": 1, "strokeColor": "#1e1e1e", "textAlign": "center", "verticalAlign": "middle", "containerId": "p1-box-1", "originalText": "Conception\n\nLe concepteur\ncoupe les décisions\nen plans clairs\navant de coder.", "autoResize": true }, { "type": "rectangle", "id": "p1-box-2", "x": 230, "y": 90, "width": 170, "height": 120, "roundness": { "type": 3 }, "backgroundColor": "#b2f2bb", "fillStyle": "solid", "boundElements": [ { "id": "p1-t-2", "type": "text" } ] }, { "type": "text", "id": "p1-t-2", "x": 235, "y": 110, "width": 160, "height": 80, "text": "Codeur\n\nL'implémenteur\nécrit le code minimal\nvérifié pas à pas,\nTDD vert.", "fontSize": 16, "fontFamily": 1, "strokeColor": "#1e1e1e", "textAlign": "center", "verticalAlign": "middle", "containerId": "p1-box-2", "originalText": "Codeur\n\nL'implémenteur\nécrit le code minimal\nvérifié pas à pas,\nTDD vert.", "autoResize": true }, { "type": "rectangle", "id": "p1-box-3", "x": 40, "y": 220, "width": 170, "height": 120, "roundness": { "type": 3 }, "backgroundColor": "#ffc9c9", "fillStyle": "solid", "boundElements": [ { "id": "p1-t-3", "type": "text" } ] }, { "type": "text", "id": "p1-t-3", "x": 45, "y": 240, "width": 160, "height": 80, "text": "Vision\n\nL'inspecteur\nregarde l'app\ncomme un usager,\ncapte les défauts.", "fontSize": 16, "fontFamily": 1, "strokeColor": "#1e1e1e", "textAlign": "center", "verticalAlign": "middle", "containerId": "p1-box-3", "originalText": "Vision\n\nL'inspecteur\nregarde l'app\ncomme un usager,\ncapte les défauts.", "autoResize": true }, { "type": "rectangle", "id": "p1-box-4", "x": 230, "y": 220, "width": 170, "height": 120, "roundness": { "type": 3 }, "backgroundColor": "#d0bfff", "fillStyle": "solid", "boundElements": [ { "id": "p1-t-4", "type": "text" } ] }, { "type": "text", "id": "p1-t-4", "x": 235, "y": 240, "width": 160, "height": 80, "text": "Recherche\n\nL'investigateur\nrapporte les sources\nfiables, pas de\ndevinettes.", "fontSize": 16, "fontFamily": 1, "strokeColor": "#1e1e1e", "textAlign": "center", "verticalAlign": "middle", "containerId": "p1-box-4", "originalText": "Recherche\n\nL'investigateur\nrapporte les sources\nfiables, pas de\ndevinettes.", "autoResize": true }, { "type": "rectangle", "id": "p1-box-5", "x": 40, "y": 350, "width": 360, "height": 120, "roundness": { "type": 3 }, "backgroundColor": "#ffd8a8", "fillStyle": "solid", "boundElements": [ { "id": "p1-t-5", "type": "text" } ] }, { "type": "text", "id": "p1-t-5", "x": 45, "y": 370, "width": 350, "height": 80, "text": "Boucle Rétro\n\nLa critique boucle\nce qui a marché\net ce qui a raté,\npour la prochaine fois.", "fontSize": 16, "fontFamily": 1, "strokeColor": "#1e1e1e", "textAlign": "center", "verticalAlign": "middle", "containerId": "p1-box-5", "originalText": "Boucle Rétro\n\nLa critique boucle\nce qui a marché\net ce qui a raté,\npour la prochaine fois.", "autoResize": true }, { "type": "arrow", "id": "p1-a1", "x": 200, "y": 150, "width": 30, "height": 0, "points": [[0,0],[30,0]], "endArrowhead": "arrow", "startBinding": { "elementId": "p1-box-1", "fixedPoint": [1, 0.5] }, "endBinding": { "elementId": "p1-box-2", "fixedPoint": [0, 0.5] } }, { "type": "text", "id": "p1-la1", "x": 190, "y": 138, "width": 50, "height": 20, "text": "↔", "fontSize": 20, "fontFamily": 1, "strokeColor": "#1e1e1e", "textAlign": "center", "verticalAlign": "middle", "containerId": "p1-a1", "originalText": "↔", "autoResize": true }, { "type": "arrow", "id": "p1-a2", "x": 200, "y": 280, "width": 30, "height": 0, "points": [[0,0],[30,0]], "endArrowhead": "arrow", "startBinding": { "elementId": "p1-box-3", "fixedPoint": [1, 0.5] }, "endBinding": { "elementId": "p1-box-4", "fixedPoint": [0, 0.5] } }, { "type": "text", "id": "p1-la2", "x": 190, "y": 268, "width": 50, "height": 20, "text": "↔", "fontSize": 20, "fontFamily": 1, "strokeColor": "#1e1e1e", "textAlign": "center", "verticalAlign": "middle", "containerId": "p1-a2", "originalText": "↔", "autoResize": true }, { "type": "arrow", "id": "p1-a3", "x": 220, "y": 410, "width": 0, "height": -70, "points": [[0,0],[0,-70]], "endArrowhead": "arrow", "strokeStyle": "dashed", "startBinding": { "elementId": "p1-box-3", "fixedPoint": [0.5, 1] }, "endBinding": { "elementId": "p1-box-5", "fixedPoint": [0.5, 0] } }, { "type": "text", "id": "p1-la3", "x": 180, "y": 375, "width": 80, "height": 20, "text": "inspect → critique", "fontSize": 14, "fontFamily": 1, "strokeColor": "#1e1e1e", "textAlign": "center", "verticalAlign": "middle", "containerId": "p1-a3", "originalText": "inspect → critique", "autoResize": true } ], "appState": { "viewBackgroundColor": "#ffffff" } }
