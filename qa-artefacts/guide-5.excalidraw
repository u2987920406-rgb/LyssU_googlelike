{ "type": "excalidraw", "version": 2, "source": "hermes-agent", "elements": [ { "type": "text", "id": "p5-t", "x": 150, "y": 20, "text": "Boucle Rétro", "fontSize": 32, "fontFamily": 1, "strokeColor": "#1e1e1e", "originalText": "Boucle Rétro", "autoResize": true }, { "type": "text", "id": "p5-s1", "x": 150, "y": 55, "text": "On améliore à chaque tour — pas à chaque erreur.", "fontSize": 18, "fontFamily": 1, "strokeColor": "#757575", "originalText": "On améliore à chaque tour — pas à chaque erreur.", "autoResize": true }, { "type": "ellipse", "id": "p5-1", "x": 60, "y": 90, "width": 120, "height": 80, "backgroundColor": "#a5d8ff", "fillStyle": "solid", "boundElements": [ { "id": "p5-t1", "type": "text" } ] }, { "type": "text", "id": "p5-t1", "x": 65, "y": 105, "width": 110, "height": 50, "text": "Faire\n\nAction, test,\nexécution,\nrésultat.", "fontSize": 16, "fontFamily": 1, "strokeColor": "#1e1e1e", "textAlign": "center", "verticalAlign": "middle", "containerId": "p5-1", "originalText": "Faire\n\nAction, test,\nexécution,\nrésultat.", "autoResize": true }, { "type": "ellipse", "id": "p5-2", "x": 220, "y": 90, "width": 120, "height": 80, "backgroundColor": "#ffcc9c", "fillStyle": "solid", "boundElements": [ { "id": "p5-t2", "type": "text" } ] }, { "type": "text", "id": "p5-t2", "x": 225, "y": 105, "width": 110, "height": 50, "text": "Observer\n\nCe qui a marché,\nce qui a raté,\nle ressenti.", "fontSize": 16, "fontFamily": 1, "strokeColor": "#1e1e1e", "textAlign": "center", "verticalAlign": "middle", "containerId": "p5-2", "originalText": "Observer\n\nCe qui a marché,\nce qui a raté,\nle ressenti.", "autoResize": true }, { "type": "ellipse", "id": "p5-3", "x": 140, "y": 200, "width": 120, "height": 80, "backgroundColor": "#fff3bf", "fillStyle": "solid", "boundElements": [ { "id": "p5-t3", "type": "text" } ] }, { "type": "text", "id": "p5-t3", "x": 145, "y": 215, "width": 110, "height": 50, "text": "Mémoriser\n\nNotebook mémoire,\nles bouts à\nretenir.", "fontSize": 16, "fontFamily": 1, "strokeColor": "#1e1e1e", "textAlign": "center", "verticalAlign": "middle", "containerId": "p5-3", "originalText": "Mémoriser\n\nNotebook mémoire,\nles bouts à\nretenir.", "autoResize": true }, { "type": "ellipse", "id": "p5-4", "x": 60, "y": 310, "width": 120, "height": 80, "backgroundColor": "#b2f2bb", "fillStyle": "solid", "boundElements": [ { "id": "p5-t4", "type": "text" } ] }, { "type": "text", "id": "p5-t4", "x": 65, "y": 325, "width": 110, "height": 50, "text": "Ajuster\n\nPlan suivant,\noutil, procédure.", "fontSize": 16, "fontFamily": 1, "strokeColor": "#1e1e1e", "textAlign": "center", "verticalAlign": "middle", "containerId": "p5-4", "originalText": "Ajuster\n\nPlan suivant,\noutil, procédure.", "autoResize": true }, { "type": "ellipse", "id": "p5-5", "x": 220, "y": 310, "width": 120, "height": 80, "backgroundColor": "#d0bfff", "fillStyle": "solid", "boundElements": [ { "id": "p5-t5", "type": "text" } ] }, { "type": "text", "id": "p5-t5", "x": 225, "y": 325, "width": 110, "height": 50, "text": "Relancer\n\nNouveau tour,\nversion suivante.", "fontSize": 16, "fontFamily": 1, "strokeColor": "#1e1e1e", "textAlign": "center", "verticalAlign": "middle", "containerId": "p5-5", "originalText": "Relancer\n\nNouveau tour,\nversion suivante.", "autoResize": true }, { "type": "arrow", "id": "p5-a1", "x": 150, "y": 130, "width": 70, "height": 0, "points": [[0,0],[70,0]], "endArrowhead": "arrow", "startBinding": { "elementId": "p5-1", "fixedPoint": [1, 0.5] }, "endBinding": { "elementId": "p5-2", "fixedPoint": [0, 0.5] } }, { "type": "text", "id": "p5-la1", "x": 160, "y": 120, "width": 50, "height": 20, "text": "→", "fontSize": 14, "fontFamily": 1, "strokeColor": "#1e1e1e", "textAlign": "center", "verticalAlign": "middle", "containerId": "p5-a1", "originalText": "→", "autoResize": true }, { "type": "arrow", "id": "p5-a2", "x": 180, "y": 170, "width": 0, "height": 30, "points": [[0,0],[0,30]], "endArrowhead": "arrow", "startBinding": { "elementId": 