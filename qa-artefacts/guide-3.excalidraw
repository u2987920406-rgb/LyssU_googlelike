{ "type": "excalidraw", "version": 2, "source": "hermes-agent", "elements": [ { "type": "text", "id": "p3-t", "x": 100, "y": 20, "text": "Comment l'agent fonctionne", "fontSize": 32, "fontFamily": 1, "strokeColor": "#1e1e1e", "originalText": "Comment l'agent fonctionne", "autoResize": true }, { "type": "text", "id": "p3-s1", "x": 100, "y": 55, "text": "Boucle : tu parles, il exécute, tu vérifies, tu décides.", "fontSize": 18, "fontFamily": 1, "strokeColor": "#757575", "originalText": "Boucle : tu parles, il exécute, tu vérifies, tu décides.", "autoResize": true }, { "type": "ellipse", "id": "p3-1", "x": 60, "y": 90, "width": 120, "height": 80, "backgroundColor": "#a5d8ff", "fillStyle": "solid", "boundElements": [ { "id": "p3-t1", "type": "text" } ] }, { "type": "text", "id": "p3-t1", "x": 65, "y": 105, "width": 110, "height": 50, "text": "Tu parles\n\nDemande claire,\ncontexte, but.", "fontSize": 16, "fontFamily": 1, "strokeColor": "#1e1e1e", "textAlign": "center", "verticalAlign": "middle", "containerId": "p3-1", "originalText": "Tu parles\n\nDemande claire,\ncontexte, but.", "autoResize": true }, { "type": "ellipse", "id": "p3-2", "x": 220, "y": 90, "width": 120, "height": 80, "backgroundColor": "#b2f2bb", "fillStyle": "solid", "boundElements": [ { "id": "p3-t2", "type": "text" } ] }, { "type": "text", "id": "p3-t2", "x": 225, "y": 105, "width": 110, "height": 50, "text": "L'agent\nréfléchit\n\nPlan, mandat,\ncompétences.", "fontSize": 16, "fontFamily": 1, "strokeColor": "#1e1e1e", "textAlign": "center", "verticalAlign": "middle", "containerId": "p3-2", "originalText": "L'agent\nréfléchit\n\nPlan, mandat,\ncompétences.", "autoResize": true }, { "type": "ellipse", "id": "p3-3", "x": 140, "y": 200, "width": 120, "height": 80, "backgroundColor": "#d0bfff", "fillStyle": "solid", "boundElements": [ { "id": "p3-t3", "type": "text" } ] }, { "type": "text", "id": "p3-t3", "x": 145, "y": 215, "width": 110, "height": 50, "text": "L'agent\nexécute\n\nAction, code,\ntest, rapport.", "fontSize": 16, "fontFamily": 1, "strokeColor": "#1e1e1e", "textAlign": "center", "verticalAlign": "middle", "containerId": "p3-3", "originalText": "L'agent\nexécute\n\nAction, code,\ntest, rapport.", "autoResize": true }, { "type": "ellipse", "id": "p3-4", "x": 60, "y": 310, "width": 120, "height": 80, "backgroundColor": "#fff3bf", "fillStyle": "solid", "boundElements": [ { "id": "p3-t4", "type": "text" } ] }, { "type": "text", "id": "p3-t4", "x": 65, "y": 325, "width": 110, "height": 50, "text": "Tu vérifies\n\nTeste, lit,\nrejet/effectue.", "fontSize": 16, "fontFamily": 1, "strokeColor": "#1e1e1e", "textAlign": "center", "verticalAlign": "middle", "containerId": "p3-4", "originalText": "Tu vérifies\n\nTeste, lit,\nrejet/effectue.", "autoResize": true }, { "type": "ellipse", "id": "p3-5", "x": 220, "y": 310, "width": 120, "height": 80, "backgroundColor": "#ffd8a8", "fillStyle": "solid", "boundElements": [ { "id": "p3-t5", "type": "text" } ] }, { "type": "text", "id": "p3-t5", "x": 225, "y": 325, "width": 110, "height": 50, "text": "Tu décides\n\nApprouve,\ncontinue, stop.", "fontSize": 16, "fontFamily": 1, "strokeColor": "#1e1e1e", "textAlign": "center", "verticalAlign": "middle", "containerId": "p3-5", "originalText": "Tu décides\n\nApprouve,\ncontinue, stop.", "autoResize": true }, { "type": "arrow", "id": "p3-a1", "x": 150, "y": 130, "width": 70, "height": 0, "points": [[0,0],[70,0]], "endArrowhead": "arrow", "startBinding": { "elementId": "p3-1", "fixedPoint": [1, 0.5] }, "endBinding": { "elementId": "p3-2", "fixedPoint": [0, 0.5] } }, { "type": "arrow", "id": "p3-a2", "x": 180, "y": 170, "width": 0, "height": 30, "points": [[0,0],[0,30]], "endArrowhead": "arrow", "startBinding": { "elementId": "p3-2", "fixedPoint": [0.5, 1] }, "endBinding": { "elementId": "p3-3", "fixedPoint": [0.5, 0] } }, { "type": "arrow", "id": "p3-a3", "x": 120, "y": 280, "width": -20, "height": 30, "points": [[0,0],[-20,30]], "endArrowhead": "arrow", "startBinding": { "elementId": "p3-3", "fixedPoint": [0, 0.5] }, "endBinding": { "elementId": "p3-4", "fixedPoint": [1, 0.5] } }, { "type": "arrow", "id": "p3-a4", "x": 200, "y": 360, "width": 0, "height": -30, "points": [[0,0],[0,-30]], "endArrowhead": "arrow", "strokeStyle": "dashed", "startBinding": { "elementId": "p3-4", "fixedPoint": [0.5, 1] }, "endBinding": { "elementId": "p3-2", "fixedPoint": [0.5, 1] } }, { "type": "text", "id": "p3-la1", "x": 160, "y": 120, "width": 50, "height": 20, "text": "→", "fontSize": 14, "fontFamily": 1, "strokeColor": "#1e1e1e", "textAlign": "center", "verticalAlign": "middle", "containerId": "p3-a1", "originalText": "→", "autoResize": true }, { "type": "text", "id": "p3-la2", "x": 150, "y": 180, "width": 80, "height": 20, "text": "exécute", "fontSize": 14, "fontFamily": 1, "strokeColor": "#1e1e1e", "textAlign": "center", "verticalAlign": "middle", "containerId": "p3-a2", "originalText": "exécute", "autoResize": true }, { "type": "text", "id": "p3-la3", "x": 90, "y": 285, "width": 60, "height": 20, "text": "→", "fontSize": 14, "fontFamily": 1, "strokeColor": "#1e1e1e", "textAlign": "center", "verticalAlign": "middle", "containerId": "p3-a3", "originalText": "→", "autoResize": true }, { "type": "text", "id": "p3-la4", "x": 190, "y": 335, "width": 60, "height": 20, "text": "boucle rétro", "fontSize": 14, "fontFamily": 1, "strokeColor": "#1e1e1e", "textAlign": "center", "verticalAlign": "middle", "containerId": "p3-a4", "originalText": "boucle rétro", "autoResize": true } ], "appState": { "viewBackgroundColor": "#ffffff" } }
