{ "type": "excalidraw", "version": 2, "source": "hermes-agent", "elements": [ { "type": "text", "id": "p2-t", "x": 120, "y": 20, "text": "Un mandat bien écrit", "fontSize": 32, "fontFamily": 1, "strokeColor": "#1e1e1e", "originalText": "Un mandat bien écrit", "autoResize": true }, { "type": "text", "id": "p2-s1", "x": 120, "y": 55, "text": "L'agent ne devine pas — il exécute ce que tu lui demandes.", "fontSize": 18, "fontFamily": 1, "strokeColor": "#757575", "originalText": "L'agent ne devine pas — il exécute ce que tu lui demandes.", "autoResize": true }, { "type": "rectangle", "id": "p2-box-1", "x": 40, "y": 85, "width": 180, "height": 120, "roundness": { "type": 3 }, "backgroundColor": "#a5d8ff", "fillStyle": "solid", "boundElements": [ { "id": "p2-t-1", "type": "text" } ] }, { "type": "text", "id": "p2-t-1", "x": 45, "y": 105, "width": 170, "height": 80, "text": "Objectif lié\n\nUn but clair.\nEx : « affiche la\nliste des 3\nderniers messages ».", "fontSize": 16, "fontFamily": 1, "strokeColor": "#1e1e1e", "textAlign": "center", "verticalAlign": "middle", "containerId": "p2-box-1", "originalText": "Objectif lié\n\nUn but clair.\nEx : « affiche la\nliste des 3\nderniers messages ».", "autoResize": true }, { "type": "rectangle", "id": "p2-box-2", "x": 240, "y": 85, "width": 180, "height": 120, "roundness": { "type": 3 }, "backgroundColor": "#b2f2bb", "fillStyle": "solid", "boundElements": [ { "id": "p2-t-2", "type": "text" } ] }, { "type": "text", "id": "p2-t-2", "x": 245, "y": 105, "width": 170, "height": 80, "text": "Compétences\nà activer\n\nAOù : discussion,\nCowork, exos.\nScopes précis.", "fontSize": 16, "fontFamily": 1, "strokeColor": "#1e1e1e", "textAlign": "center", "verticalAlign": "middle", "containerId": "p2-box-2", "originalText": "Compétences\nà activer\n\nAOù : discussion,\nCowork, exos.\nScopes précis.", "autoResize": true }, { "type": "rectangle", "id": "p2-box-3", "x": 40, "y": 215, "width": 180, "height": 120, "roundness": { "type": 3 }, "backgroundColor": "#c3fae8", "fillStyle": "solid", "boundElements": [ { "id": "p2-t-3", "type": "text" } ] }, { "type": "text", "id": "p2-t-3", "x": 45, "y": 235, "width": 170, "height": 80, "text": "Livrable\nattendu\n\nFichier PNG,\ncode, rapport,\ndiagramme?\nTrès précis.", "fontSize": 16, "fontFamily": 1, "strokeColor": "#1e1e1e", "textAlign": "center", "verticalAlign": "middle", "containerId": "p2-box-3", "originalText": "Livrable\nattendu\n\nFichier PNG,\ncode, rapport,\ndiagramme?\nTrès précis.", "autoResize": true }, { "type": "rectangle", "id": "p2-box-4", "x": 240, "y": 215, "width": 180, "height": 120, "roundness": { "type": 3 }, "backgroundColor": "#ffc9c9", "fillStyle": "solid", "boundElements": [ { "id": "p2-t-4", "type": "text" } ] }, { "type": "text", "id": "p2-t-4", "x": 245, "y": 235, "width": 170, "height": 80, "text": "Critères\nde fin\n\nQuand s'arrête-\nt-on ? Vérification\nvisible, test vert.", "fontSize": 16, "fontFamily": 1, "strokeColor": "#1e1e1e", "textAlign": "center", "verticalAlign": "middle", "containerId": "p2-box-4", "originalText": "Critères\nde fin\n\nQuand s'arrête-\nt-on ? Vérification\nvisible, test vert.", "autoResize": true }, { "type": "arrow", "id": "p2-a1", "x": 210, "y": 145, "width": 30, "height": 0, "points": [[0,0],[30,0]], "endArrowhead": "arrow", "startBinding": { "elementId": "p2-box-1", "fixedPoint": [1, 0.5] }, "endBinding": { "elementId": "p2-box-2", "fixedPoint": [0, 0.5] } }, { "type": "text", "id": "p2-la1", "x": 195, "y": 130, "width": 60, "height": 20, "text": "plus précis", "fontSize": 14, "fontFamily": 1, "strokeColor": "#1e1e1e", "textAlign": "center", "verticalAlign": "middle", "containerId": "p2-a1", "originalText": "plus précis", "autoResize": true }, { "type": "arrow", "id": "p2-a2", "x": 210, "y": 275, "width": 30, "height": 0, "points": [[0,0],[30,0]], "endArrowhead": "arrow", "startBinding": { "elementId": "p2-box-3", "fixedPoint": [1, 0.5] }, "endBinding": { "elementId": "p2-box-4", "fixedPoint": [0, 0.5] } }, { "type": "text", "id": "p2-la2", "x": 195, "y": 260, "width": 60, "height": 20, "text": "vérifie", "fontSize": 14, "fontFamily": 1, "strokeColor": "#1e1e1e", "textAlign": "center", "verticalAlign": "middle", "containerId": "p2-a2", "originalText": "vérifie", "autoResize": true } ], "appState": { "viewBackgroundColor": "#ffffff" } }
